// Internal library for the AEGIS system service; not an independently callable app.
java_library {
    name: "aegis-identity-core",
    srcs: ["src/**/*.java"],
    libs: ["framework"],
    installable: false,
}

java_library {
    name: "aegis-identity-protocol",
    srcs: ["aidl/**/*.aidl"],
    aidl: { local_include_dirs: ["aidl"] },
    libs: ["framework"],
    installable: false,
}

java_library {
    name: "aegis-identity-service",
    system_ext_specific: true,
    srcs: ["service/**/*.java"],
    static_libs: ["aegis-identity-core", "aegis-identity-protocol"],
    libs: ["framework", "services.core"],
    installable: true,
}

java_binary {
    name: "aegis",
    system_ext_specific: true,
    // The pinned Soong default wrapper hardcodes /system/framework.
    wrapper: "cli/aegis",
    srcs: ["cli/**/*.java"],
    static_libs: ["aegis-identity-protocol"],
    libs: ["framework"],
    main_class: "org.aegisos.identity.Aegis",
}

android_test {
    name: "AegisIdentityTests",
    manifest: "tests/AndroidManifest.xml",
    srcs: ["tests/src/**/*.java"],
    static_libs: ["aegis-identity-core", "aegis-runtime-storage-gate", "androidx.test.runner", "androidx.test.ext.junit"],
    platform_apis: true,
    certificate: "platform",
    test_suites: ["device-tests"],
}

// The production source is installed into pinned services.core by the source
// integrator. This noninstalled library gives device tests their own copy.
java_library {
    name: "aegis-runtime-storage-gate",
    srcs: ["platform/**/*.java"],
    libs: ["framework"],
    installable: false,
}

// Explicit builder targets only. No PRODUCT_PACKAGES/init.rc entry: the AOSP
// broker, private mount setup and SELinux transition are not integrated yet.
cc_defaults {
    name: "aegis-runtime-native-defaults",
    enabled: false,
    arch: { arm64: { enabled: true } },
    compile_multilib: "64",
    c_std: "gnu11",
    cflags: ["-Wall", "-Wextra", "-Werror"],
}

cc_binary {
    name: "aegis-runtime-init",
    defaults: ["aegis-runtime-native-defaults"],
    srcs: ["runtime/init.c", "runtime/control.c", "runtime/sandbox.c"],
    static_executable: true,
    stl: "none",
}

// Trusted namespace PID1 mount helper. Still an explicit component target:
// broker authorization, resource groups and SELinux policy are not wired yet.
cc_binary {
    name: "aegis-runtime-setup",
    defaults: ["aegis-runtime-native-defaults"],
    srcs: ["runtime/setup.c", "runtime/setup_control.c", "runtime/control.c", "runtime/sandbox.c"],
    static_executable: true,
    stl: "none",
}

// Internal primitive for the forthcoming broker/launcher. No public process
// control endpoint; not linked into the namespace init or installed as a daemon.
cc_library_static {
    name: "libaegis-runtime-child",
    defaults: ["aegis-runtime-native-defaults"],
    srcs: ["runtime/child.c"],
    export_include_dirs: ["runtime"],
    stl: "none",
}

cc_library_static {
    name: "libaegis-runtime-namespace",
    defaults: ["aegis-runtime-native-defaults"],
    srcs: ["runtime/namespace.c", "runtime/mounts.c", "runtime/ce.c", "runtime/devices.c", "runtime/memory_group.c"],
    header_libs: ["libcutils_headers"],
    static_libs: ["libaegis-runtime-child"],
    export_include_dirs: ["runtime"],
    stl: "none",
}

// Assembles the namespace/mount/memory lifecycle for the forthcoming broker.
// No client endpoint or authentication; callers also link the private protocol.
cc_library_static {
    name: "libaegis-runtime-context",
    defaults: ["aegis-runtime-native-defaults"],
    srcs: ["runtime/context.c", "runtime/exec.c"],
    static_libs: ["libaegis-runtime-namespace"],
    export_include_dirs: ["runtime"],
    stl: "none",
}

// Private system-server/native-owner protocol. No daemon or socket is installed
// until resource recovery, image mounts and SELinux integration are complete.
cc_library_static {
    name: "libaegis-runtime-broker-protocol",
    defaults: ["aegis-runtime-native-defaults"],
    srcs: ["runtime/broker_protocol.c"],
    export_include_dirs: ["runtime"],
    stl: "none",
}

cc_library_static {
    name: "libaegis-runtime-broker-owner",
    defaults: ["aegis-runtime-native-defaults"],
    srcs: ["runtime/broker_owner.c"],
    static_libs: ["libaegis-runtime-context", "libaegis-runtime-broker-protocol"],
    export_include_dirs: ["runtime"],
    stl: "none",
}

// Immutable system_ext base validation and detached readonly mount; not yet
// called by a production daemon or granted a production SELinux policy.
cc_library_static {
    name: "libaegis-runtime-base",
    defaults: ["aegis-runtime-native-defaults"],
    srcs: ["runtime/base_image.cpp"],
    static_libs: ["libbase", "libjsoncpp"],
    // Android intentionally provides libcrypto only as a shared FIPS module.
    // Keep that implementation; do not relax the static variant's visibility.
    shared_libs: ["libcrypto"],
    export_include_dirs: ["runtime"],
}

cc_library_static {
    name: "libaegis-runtime-broker-cgroup",
    defaults: ["aegis-runtime-native-defaults"],
    srcs: ["runtime/broker_cgroup.c"],
    export_include_dirs: ["runtime"],
    stl: "none",
}

// Explicit compile target. No init service or PRODUCT_PACKAGES activation
// until SELinux, system_server registration and local device checks pass.
cc_binary {
    name: "aegis-runtime-broker",
    system_ext_specific: true,
    init_rc: ["runtime/aegis-runtime.rc"],
    defaults: ["aegis-runtime-native-defaults"],
    srcs: ["runtime/broker.c", "runtime/control.c", "runtime/setup_control.c"],
    header_libs: ["libcutils_headers"],
    shared_libs: ["libcutils", "libselinux", "libcrypto", "liblog"],
    static_libs: ["libaegis-runtime-broker-owner", "libaegis-runtime-broker-cgroup",
                  "libaegis-runtime-base", "libaegis-runtime-context",
                  "libaegis-runtime-namespace", "libaegis-runtime-child",
                  "libaegis-runtime-broker-protocol", "libbase", "libjsoncpp"],
}

// Inert trusted probe for device tests; never a production setup helper.
cc_binary {
    name: "aegis-runtime-namespace-probe",
    defaults: ["aegis-runtime-native-defaults"],
    srcs: ["runtime/namespace_probe.c"],
    static_executable: true,
    stl: "none",
}

// Compile on aegis-build; execute ONLY in the local Android QEMU guest.
cc_test {
    name: "AegisRuntimeNativeTests",
    defaults: ["aegis-runtime-native-defaults"],
    srcs: ["runtime/tests.cpp", "runtime/child_tests.cpp", "runtime/namespace_tests.cpp", "runtime/memory_group_tests.cpp", "runtime/broker_protocol_tests.cpp", "runtime/base_image_tests.cpp", "runtime/ce_tests.cpp", "runtime/setup_tests.cpp", "runtime/exec_tests.cpp", "runtime/setup_control.c", "runtime/control.c", "runtime/sandbox.c"],
    header_libs: ["libcutils_headers"],
    static_libs: ["libaegis-runtime-child", "libaegis-runtime-namespace", "libaegis-runtime-context", "libaegis-runtime-broker-protocol", "libaegis-runtime-broker-owner", "libaegis-runtime-base", "libaegis-runtime-broker-cgroup", "libbase", "libjsoncpp"],
    // The test process uses the same system libcrypto as the broker. The
    // namespace setup/init/probe helpers remain separate static executables.
    shared_libs: ["libcrypto", "liblog"],
    data_bins: ["aegis-runtime-init", "aegis-runtime-namespace-probe", "aegis-runtime-setup"],
    test_suites: ["device-tests"],
}
