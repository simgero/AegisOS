# Same additions for the GKI base and every virtual-device module build.
# Existing SELinux, module signing, seccomp and Android security options remain.
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_NET_NS=y
CONFIG_SYSVIPC=y
CONFIG_IPC_NS=y
CONFIG_POSIX_MQUEUE=y
# Private tmpfs fixtures/views need xattrs; the original GKI disabled them.
CONFIG_TMPFS_XATTR=y
