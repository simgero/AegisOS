# Trusted owner and namespace construction are separate from ordinary GNU code.
type aegis_runtime_broker, domain, coredomain, aegis_runtime_domain,
    aegis_runtime_mount_domain, aegis_runtime_broker_domain;
type aegis_runtime_setup, domain, coredomain, aegis_runtime_domain,
    aegis_runtime_mount_domain;
type aegis_runtime_init, domain, coredomain, aegis_runtime_domain,
    aegis_runtime_exec_domain;
type aegis_runtime_program, domain, coredomain, aegis_runtime_domain,
    aegis_runtime_exec_domain;
type aegis_runtime_broker_exec, exec_type, file_type, system_file_type;
type aegis_runtime_setup_exec, exec_type, file_type, system_file_type;
type aegis_runtime_init_exec, exec_type, file_type, system_file_type;
# Immutable trusted hash/mount worker. It runs no GNU code or package scripts.
type aegis_runtime_prepare_exec, exec_type, file_type, system_file_type;
# Fixed package product inputs. Startup pins and reads them; execution-domain
# integration is separate, and no public package wire operation exists yet.
type aegis_package_plan_exec, exec_type, file_type, system_file_type;
type aegis_package_network_exec, exec_type, file_type, system_file_type;
type aegis_package_execute_exec, exec_type, file_type, system_file_type;
type aegis_package_publish_exec, exec_type, file_type, system_file_type;
allow aegis_runtime_broker { aegis_package_plan_exec aegis_package_network_exec
    aegis_package_execute_exec aegis_package_publish_exec }:file r_file_perms;
neverallow { aegis_runtime_setup aegis_runtime_init aegis_runtime_program }
    { aegis_package_plan_exec aegis_package_network_exec aegis_package_execute_exec
      aegis_package_publish_exec }:file { execute execute_no_trans entrypoint };


type aegis_runtime_image_file, file_type, system_file_type;
# A context-mounted filesystem is an fs_type, never also a file_type.
# Its contents stay protected by AOSP's immutable contextmount neverallows.
type aegis_runtime_base_file, fs_type, contextmount_type;
type aegis_runtime_state_file, file_type, data_file_type, core_data_file_type;
type aegis_runtime_home_file, file_type, data_file_type, core_data_file_type;
# Broker-only CE package backing files, never ordinary HOME or session mounts.
type aegis_package_private_file, file_type, data_file_type, core_data_file_type;
type aegis_package_shared_file, file_type, data_file_type, core_data_file_type;
# Mutable, unpublished shared candidates are distinct from immutable generations.
type aegis_package_staging_file, file_type, data_file_type, core_data_file_type;
# Contents of one unpublished ext4 candidate. This is an inode file_type,
# never a contextmount_type or a relabeled filesystem. defcontext supplies it
# only when an inode has no stored SELinux xattr; mixed labels are rejected.
type aegis_package_candidate_file, file_type;
allow aegis_package_candidate_file labeledfs:filesystem associate;
allow aegis_runtime_broker aegis_package_candidate_file:dir create_dir_perms;
allow aegis_runtime_broker aegis_package_candidate_file:file create_file_perms;
allow aegis_runtime_broker aegis_package_candidate_file:lnk_file r_file_perms;
neverallow { aegis_runtime_broker aegis_runtime_setup aegis_runtime_init aegis_runtime_program }
    aegis_package_candidate_file:file { execute execute_no_trans entrypoint };
neverallow { aegis_runtime_setup aegis_runtime_init aegis_runtime_program }
    aegis_package_candidate_file:dir { open read search write add_name remove_name };

type aegis_runtime_devices_file, file_type;
type aegis_runtime_scratch_file, file_type, coredomain_socket;
type aegis_runtime_cgroup, fs_type;
type aegis_runtime_delegation, fs_type;
type aegis_runtime_entry, fs_type;
type aegis_runtime_owner_cgroup, fs_type;
type aegis_runtime_socket, file_type, coredomain_socket;
type aegis_runtime_namespace_file, fs_type;

# AOSP removes CE subdirectories after stopping the user and destroying keys.
# Permit its existing dedicated cleaner to unlink our private tree, including
# names that are now encrypted. It receives no file-content or creation access.
allow vold_prepare_subdirs { aegis_runtime_home_file aegis_package_private_file }:dir { getattr open read search write remove_name rmdir };
allow vold_prepare_subdirs { aegis_runtime_home_file aegis_package_private_file }:{ file lnk_file fifo_file sock_file } { getattr unlink };
neverallow vold_prepare_subdirs { aegis_runtime_home_file aegis_package_private_file }:dir { create add_name setattr relabelfrom relabelto mounton ioctl };
neverallow vold_prepare_subdirs { aegis_runtime_home_file aegis_package_private_file }:file { create open read write append map execute execute_no_trans link rename setattr ioctl };
neverallow vold_prepare_subdirs { aegis_runtime_home_file aegis_package_private_file }:{ lnk_file fifo_file sock_file } { create read write append setattr link rename };

# Give NSFS its own label instead of granting the new owner access to generic
# unlabeled files. Preserve the existing AOSP domains' already-authorized
# read access to these formerly-unlabeled objects, without adding subjects.
allow { init vold system_server installd } aegis_runtime_namespace_file:file { getattr open read };
allow dex2oat aegis_runtime_namespace_file:file read;
allow { aegis_runtime_broker aegis_runtime_setup aegis_runtime_init }
    aegis_runtime_namespace_file:file { getattr open read ioctl };
# NS_GET_NSTYPE; helpers additionally verify the owning user namespace.
allowxperm aegis_runtime_broker aegis_runtime_namespace_file:file ioctl { 0xb703 };
allowxperm { aegis_runtime_setup aegis_runtime_init }
    aegis_runtime_namespace_file:file ioctl { 0xb701 0xb703 };
allow aegis_runtime_program aegis_runtime_namespace_file:file getattr;
neverallow aegis_runtime_domain aegis_runtime_namespace_file:file { write append map execute };

# Private attributes are not general exceptions other domains can reuse.
# All domains receive self:fork from AOSP; these guards close membership.
neverallow { aegis_runtime_broker_domain -aegis_runtime_broker } self:process fork;
neverallow { aegis_runtime_mount_domain -aegis_runtime_broker -aegis_runtime_setup } self:process fork;
neverallow { aegis_runtime_exec_domain -aegis_runtime_init -aegis_runtime_program } self:process fork;
neverallow { aegis_runtime_domain -aegis_runtime_broker -aegis_runtime_setup
    -aegis_runtime_init -aegis_runtime_program } self:process fork;

init_daemon_domain(aegis_runtime_broker)
domain_auto_trans(aegis_runtime_broker, aegis_runtime_setup_exec, aegis_runtime_setup)
domain_auto_trans(aegis_runtime_setup, aegis_runtime_init_exec, aegis_runtime_init)
domain_auto_trans(aegis_runtime_init, aegis_runtime_base_file, aegis_runtime_program)
# Both static helpers are pinned on the immutable Android system mount. After
# entering the child's user namespace, mnt_may_suid treats that foreign mount
# as nosuid, including the retained init executable after pivot_root. Permit
# only the fixed helper transitions; never execute either in the old domain.
allow aegis_runtime_broker aegis_runtime_setup:process2 nosuid_transition;
allow aegis_runtime_setup aegis_runtime_init:process2 nosuid_transition;
# The supervisor deliberately sets no_new_privs and the base remains nosuid.
# This transition grants no capabilities or Android management access.
allow aegis_runtime_init aegis_runtime_program:process2 { nnp_transition nosuid_transition };
neverallow * { aegis_runtime_broker aegis_runtime_setup aegis_runtime_init
    aegis_runtime_program }:process dyntransition;
neverallow { domain -init } aegis_runtime_broker:process transition;
neverallow { domain -aegis_runtime_broker } aegis_runtime_setup:process transition;
neverallow { domain -aegis_runtime_setup } aegis_runtime_init:process transition;
neverallow { domain -aegis_runtime_init } aegis_runtime_program:process transition;
neverallow aegis_runtime_domain { shell_exec toolbox_exec }:file execute;
neverallow aegis_runtime_exec_domain { fs_type -aegis_runtime_base_file }:file execute;
# Ordinary programs and setup must not inherit Android's broad cgroup access.
neverallow aegis_runtime_domain { cgroup cgroup_v2 }:file { write append };

# The sole externally reachable endpoint is init-owned, system:system 0600.
# Native code additionally requires exact system_server SO_PEERCRED/SO_PEERSEC.
allow aegis_runtime_broker self:unix_stream_socket create_stream_socket_perms;
allow aegis_runtime_broker aegis_runtime_socket:sock_file { getattr read write };
allow system_server aegis_runtime_socket:sock_file { getattr write };
allow system_server aegis_runtime_broker:unix_stream_socket connectto;
allow system_server aegis_runtime_broker:fd use;
allow aegis_runtime_broker system_server:fd use;
# The owner's internal socketpairs share its domain; external peers are only
# system_server, also checked by credentials and context in the native code.
neverallow { domain -system_server -aegis_runtime_broker } aegis_runtime_broker:unix_stream_socket connectto;
get_prop(aegis_runtime_broker, aegis_runtime_mode_prop)

# Fixed broker-owned lock, no client-selected paths.
allow aegis_runtime_broker system_data_root_file:dir { getattr search open read };
allow aegis_runtime_broker system_data_file:dir { getattr search open read write add_name remove_name ioctl };
allow aegis_runtime_broker system_userdir_file:dir { getattr search open read };
allow aegis_runtime_broker aegis_runtime_state_file:dir rw_dir_perms;
allow aegis_runtime_broker aegis_runtime_state_file:file create_file_perms;
type_transition aegis_runtime_broker system_data_file:dir aegis_runtime_home_file ".aegis-preparing";
allow aegis_runtime_broker aegis_runtime_home_file:dir create_dir_perms;
type_transition aegis_runtime_broker aegis_runtime_home_file:dir aegis_package_private_file ".packages-preparing";
allow aegis_runtime_broker aegis_package_private_file:dir create_dir_perms;
# No raw package bytes are mapped/executed by the broker or ordinary runtime.
neverallow { aegis_runtime_setup aegis_runtime_init aegis_runtime_program }
    aegis_package_private_file:dir { open read search write add_name remove_name };
neverallow { aegis_runtime_broker aegis_runtime_setup aegis_runtime_init aegis_runtime_program }
    aegis_package_private_file:file { execute execute_no_trans map };
allow aegis_runtime_broker aegis_runtime_home_file:filesystem { getattr remount };
# CE policy/key status is read-only; no key creation/removal ioctl is granted.
allowxperm aegis_runtime_broker { system_data_file aegis_runtime_home_file aegis_package_private_file }:dir ioctl { 0x6616 0x661a };
neverallowxperm aegis_runtime_broker { data_file_type -system_data_file
    -aegis_runtime_home_file -aegis_package_private_file }:dir ioctl { FS_IOC_GET_ENCRYPTION_KEY_STATUS };
allow aegis_runtime_broker self:capability {
    chown dac_override dac_read_search fowner kill setgid setuid sys_admin mknod
};

# Init assigns the broker's private leaf. It is outside all workload limits and
# recovery kills. No runtime domain may change its owner/delegation controls.
neverallow aegis_runtime_domain { aegis_runtime_delegation aegis_runtime_owner_cgroup }:file { write append };
neverallow { aegis_runtime_domain -aegis_runtime_broker } aegis_runtime_entry:file { write append };
allow init { aegis_runtime_delegation aegis_runtime_owner_cgroup }:dir create_dir_perms;
allow init { aegis_runtime_delegation aegis_runtime_owner_cgroup aegis_runtime_entry }:file rw_file_perms;
type_transition init cgroup_v2:dir aegis_runtime_delegation "aegis-runtime";
type_transition init aegis_runtime_delegation:dir aegis_runtime_owner_cgroup "broker";
allow { aegis_runtime_delegation aegis_runtime_owner_cgroup aegis_runtime_entry } cgroup_v2:filesystem associate;
# Private workload subtree; shared Android controller settings stay read-only.
allow aegis_runtime_broker cgroup_v2:dir r_dir_perms;
allow aegis_runtime_broker cgroup_v2:file r_file_perms;
allow aegis_runtime_broker aegis_runtime_delegation:dir { r_dir_perms write add_name };
allow aegis_runtime_broker aegis_runtime_delegation:file r_file_perms;
r_dir_file(aegis_runtime_broker, aegis_runtime_owner_cgroup)
# clone3 requires write permission on this private common ancestor's procs
# inode. It is not a grant for root cgroup.procs or any ancestor controller.
allow aegis_runtime_broker aegis_runtime_entry:file rw_file_perms;
type_transition aegis_runtime_broker aegis_runtime_delegation:dir aegis_runtime_cgroup "contexts";
allow aegis_runtime_cgroup cgroup_v2:filesystem associate;
allow aegis_runtime_broker aegis_runtime_cgroup:dir create_dir_perms;
allow aegis_runtime_broker aegis_runtime_cgroup:file rw_file_perms;

# Startup validation of fixed immutable EROFS files and a readonly loop mount.
r_dir_file(aegis_runtime_broker, aegis_runtime_image_file)
# The loop driver's worker reads the broker-opened immutable backing file.
# Same descriptor-use pattern as AOSP's kernel/apexd loopback integration;
# no new write access, path traversal or permission for ordinary GNU programs.
allow kernel aegis_runtime_broker:fd use;
allow kernel aegis_runtime_image_file:file read;
# Loop I/O uses the trusted opener's backing fd. Private copied candidates need
# both directions; this grants no pathname traversal, opening or execution.
allow kernel aegis_package_private_file:file { read write };
allow aegis_runtime_broker { aegis_runtime_setup_exec aegis_runtime_init_exec }:file r_file_perms;
allow aegis_runtime_broker block_device:dir { getattr search };
allow aegis_runtime_broker loop_control_device:chr_file rw_file_perms;
allowxperm aegis_runtime_broker loop_control_device:chr_file ioctl { LOOP_CTL_GET_FREE };
allow aegis_runtime_broker loop_device:blk_file rw_file_perms;
allowxperm aegis_runtime_broker loop_device:blk_file ioctl {
    LOOP_CONFIGURE LOOP_GET_STATUS64 BLKGETSIZE64 BLKROGET
};
allow aegis_runtime_broker labeledfs:filesystem { mount relabelfrom };
# context= first labels the superblock, then labels its root inode. The second
# check uses the already-selected base SID as relabelfrom (pinned hooks.c,
# selinux_set_mnt_opts / may_context_mount_inode_relabel). No other base label
# or ordinary program gains this permission.
allow aegis_runtime_broker aegis_runtime_base_file:filesystem { mount remount relabelfrom relabelto unmount };
# The fixed MS_REC|MS_PRIVATE operation on / follows unshare(CLONE_NEWNS).
# SELinux checks mounton even for a propagation change. Only the trusted owner
# may isolate this inherited root; ordinary programs get no root mount rights.
allow aegis_runtime_broker rootfs:dir mounton;
allow aegis_runtime_broker tmpfs:dir mounton;
# The fixed private /mnt anchor already holds the verified factory mount.
# Selecting another generation briefly stacks its checked readonly mount there
# for open_tree(CLONE), then verifies its mount ID and detaches that top layer.
# Actual product denial: broker -> base root /mnt, dir mounton (6473cf51).
allow aegis_runtime_broker aegis_runtime_base_file:dir mounton;
neverallow { aegis_runtime_init aegis_runtime_program } aegis_runtime_base_file:dir mounton;
r_dir_file(aegis_runtime_mount_domain, aegis_runtime_base_file)

# fs_use_trans selects a transition using the actual inode class. A new
# tmpfs root is a directory; a file-only rule leaves that root labeled tmpfs.
# Children inherit the private directory type through normal inode creation.
# Neither private tmpfs type is executable.
type_transition aegis_runtime_broker tmpfs:{ dir file } aegis_runtime_devices_file;
type_transition aegis_runtime_setup tmpfs:{ dir file } aegis_runtime_scratch_file;
allow aegis_runtime_mount_domain tmpfs:filesystem { mount remount unmount };
allow aegis_runtime_broker aegis_runtime_devices_file:dir create_dir_perms;
allow aegis_runtime_broker aegis_runtime_devices_file:chr_file { create setattr getattr };
allow aegis_runtime_broker aegis_runtime_devices_file:lnk_file { create getattr read setattr unlink rename };
allow aegis_runtime_devices_file tmpfs:filesystem associate;
allow aegis_runtime_scratch_file tmpfs:filesystem associate;
allow aegis_runtime_setup aegis_runtime_scratch_file:dir create_dir_perms;
allow aegis_runtime_setup aegis_runtime_scratch_file:dir mounton;
allow aegis_runtime_setup { aegis_runtime_base_file aegis_runtime_devices_file
    aegis_runtime_home_file }:dir { getattr open read search mounton };
# selinux_file_receive maps O_PATH references (neither FMODE_READ nor WRITE)
# to FILE__IOCTL. The fixed private SCM_RIGHTS channel transfers detached HOME
# and device roots this way. This adds no ioctl command numbers; AOSP's xperm
# allowlist and vold-only key-mutation guards remain in force.
allow aegis_runtime_setup { aegis_runtime_home_file aegis_runtime_devices_file }:dir ioctl;
allow aegis_runtime_setup aegis_runtime_devices_file:chr_file getattr;
allow aegis_runtime_setup aegis_runtime_devices_file:lnk_file r_file_perms;
allow aegis_runtime_setup { aegis_runtime_base_file labeledfs proc devpts mqueue }:filesystem { mount remount unmount };
# /mnt still refers to the broker's readonly private base at this point.
allow aegis_runtime_setup tmpfs:dir { getattr search mounton };
allow aegis_runtime_setup self:cap_userns { chown fowner setuid setgid sys_admin };

# Kernel-generated /proc/<pid> nodes carry the task domain, not generic proc.
allow aegis_runtime_domain proc:dir r_dir_perms;
allow aegis_runtime_domain proc:lnk_file r_file_perms;
allow aegis_runtime_domain self:dir r_dir_perms;
allow aegis_runtime_domain self:file r_file_perms;
allow aegis_runtime_domain self:lnk_file r_file_perms;
allow aegis_runtime_mount_domain selinuxfs:file r_file_perms;
allow aegis_runtime_broker self:file { write ioctl };
# No /proc/1 lookup or readproc group: initial namespace handles come only from
# init's fixed service-file descriptors. The gated clone sends its OWN proc
# inode references and user-namespace fd through a private inherited socket.
# Parent map opens traverse only its own fd table, never another PID's proc.
allow aegis_runtime_broker self:user_namespace create;
# pidfd_send_signal on the broker's own mapped child checks CAP_KILL in the
# child's user namespace. The host capability does not cover this LSM class.
allow aegis_runtime_broker self:cap_userns { kill setuid setgid sys_admin };
neverallow aegis_runtime_broker self:global_capability_class_set sys_ptrace;
neverallow aegis_runtime_broker init:process ptrace;

# Trusted, inherited descriptor-only setup/supervision protocol; no named socket.
allow { aegis_runtime_setup aegis_runtime_init } aegis_runtime_broker:fd use;
allow { aegis_runtime_setup aegis_runtime_init } aegis_runtime_broker:unix_stream_socket { read write getattr getopt setopt shutdown };
allow aegis_runtime_broker { aegis_runtime_setup aegis_runtime_init }:fd use;
allow aegis_runtime_broker { aegis_runtime_setup aegis_runtime_init aegis_runtime_program }:process { signal sigkill sigchld };
allow aegis_runtime_init aegis_runtime_broker:process sigchld;
allow aegis_runtime_init aegis_runtime_setup:fd use;
allow aegis_runtime_setup aegis_runtime_init_exec:file r_file_perms;

# The namespace supervisor drops its bounding set and keeps only namespace IDs
# and kill until forking the shell. Ordinary program children drop all caps.
allow aegis_runtime_init self:cap_userns { setpcap setuid setgid kill };
allow aegis_runtime_init aegis_runtime_program:process { signal sigkill };
allow aegis_runtime_init { aegis_runtime_base_file aegis_runtime_home_file
    aegis_runtime_scratch_file aegis_runtime_devices_file }:dir r_dir_perms;
# The Debian merged-/usr base resolves /bin/bash through /bin -> usr/bin.
# The child resolves this path during exec, before the GNU domain transition.
allow aegis_runtime_init aegis_runtime_base_file:lnk_file { getattr read };
allow aegis_runtime_init aegis_runtime_devices_file:lnk_file r_file_perms;
allow aegis_runtime_init aegis_runtime_devices_file:chr_file rw_file_perms;
allow aegis_runtime_init devpts:dir r_dir_perms;
create_pty(aegis_runtime_init)
# The fresh devpts mount creates its ptmx inode in setup, before init creates
# a slave. Both ends use the private type; no general Android devpts access.
type_transition aegis_runtime_setup devpts:chr_file aegis_runtime_init_devpts;
allow aegis_runtime_setup aegis_runtime_init_devpts:chr_file getattr;
allowxperm aegis_runtime_init aegis_runtime_init_devpts:chr_file ioctl { TIOCGPTN TIOCSPTLCK };
allow { aegis_runtime_broker system_server aegis_runtime_program } aegis_runtime_init:fd use;
allow { aegis_runtime_broker system_server aegis_runtime_program } aegis_runtime_init_devpts:chr_file rw_file_perms;
allowxperm { aegis_runtime_broker system_server aegis_runtime_program } aegis_runtime_init_devpts:chr_file ioctl unpriv_tty_ioctls;
# Validate the slave's mapped owner through the received master descriptor.
# 0x5441 is TIOCGPTPEER in the pinned kernel; AOSP has no named ioctl macro.
allowxperm aegis_runtime_broker aegis_runtime_init_devpts:chr_file ioctl { TIOCGPTN 0x5441 };

# GNU programs see only their pivoted root, private namespaces and CE HOME.
# There is no permission to mutate the shared software or execute writable data.
r_dir_file(aegis_runtime_program, aegis_runtime_base_file)
allow aegis_runtime_program aegis_runtime_base_file:file { rx_file_perms execute_no_trans };
allow aegis_runtime_program { aegis_runtime_home_file aegis_runtime_scratch_file }:dir create_dir_perms;
allow aegis_runtime_program { aegis_runtime_home_file aegis_runtime_scratch_file }:file create_file_perms;
allow aegis_runtime_program { aegis_runtime_home_file aegis_runtime_scratch_file }:lnk_file { create getattr read setattr unlink rename };
allow aegis_runtime_program { aegis_runtime_home_file aegis_runtime_scratch_file }:fifo_file create_file_perms;
allow aegis_runtime_program { aegis_runtime_home_file aegis_runtime_scratch_file }:sock_file create_file_perms;
allow aegis_runtime_program aegis_runtime_devices_file:dir r_dir_perms;
allow aegis_runtime_program aegis_runtime_devices_file:lnk_file r_file_perms;
allow aegis_runtime_program aegis_runtime_devices_file:chr_file rw_file_perms;
allow aegis_runtime_program self:unix_stream_socket create_stream_socket_perms;
allow aegis_runtime_program self:unix_dgram_socket create_socket_perms;
neverallow aegis_runtime_program self:global_capability_class_set *;
neverallow aegis_runtime_program self:user_namespace create;
neverallow { aegis_runtime_init aegis_runtime_program } fs_type:filesystem { mount remount relabelfrom relabelto };
neverallow aegis_runtime_domain { aegis_runtime_home_file aegis_runtime_scratch_file }:file execute;
neverallow aegis_runtime_program { aegis_runtime_broker aegis_runtime_setup aegis_runtime_init system_server }:process { ptrace signal sigkill sigstop };

# Generation selection is trusted broker work, executed only from the pinned
# immutable helper after registering the requester. It remains in the owner's
# domain and bounded workload cgroup; it never executes package contents.
allow aegis_runtime_broker aegis_runtime_prepare_exec:file { rx_file_perms execute_no_trans };
# A sealed memfd carries only bounded selection metadata into the worker. The
# existing broker tmpfs transition labels it with this non-executable type.
allow aegis_runtime_broker aegis_runtime_devices_file:file { create open read write getattr setattr };
# Read-only existing package stores, including flock on a read-only lock FD.
# No package bytes or metadata writes are enabled by selection integration.
allow aegis_runtime_broker aegis_package_private_file:file { getattr open read lock };
allow aegis_runtime_broker aegis_package_shared_file:dir { getattr open read search };
allow aegis_runtime_broker aegis_package_shared_file:file { getattr open read lock };
allow kernel aegis_package_shared_file:file read;
neverallow aegis_runtime_domain aegis_package_shared_file:file { execute execute_no_trans map };
neverallow { aegis_runtime_setup aegis_runtime_init aegis_runtime_program }
    aegis_package_shared_file:dir { open read search write add_name remove_name };

# Bootstrap reads only the signed, readonly Conscrypt APEX certificates. The
# broker validates mount/owner/label and seals its bounded copy before listening.
r_dir_file(aegis_runtime_broker, system_security_cacerts_file)

# Fixed shared working area, opened by the registered broker job only. Package
# programs receive a private mount of candidate contents, never these host paths.
type_transition aegis_runtime_broker aegis_runtime_state_file:dir aegis_package_staging_file "shared-staging";
allow aegis_runtime_broker aegis_package_staging_file:dir create_dir_perms;
allow aegis_runtime_broker aegis_package_staging_file:file { create open read write getattr setattr unlink };
# Kernel loop I/O through the trusted opener's fd; no pathname access/execute.
allow kernel aegis_package_staging_file:file { read write };
neverallow aegis_runtime_domain aegis_package_staging_file:file { execute execute_no_trans map };
neverallow { aegis_runtime_setup aegis_runtime_init aegis_runtime_program }
    aegis_package_staging_file:dir { open read search write add_name remove_name };
# Shared generations stay readonly to the loop driver.
neverallow kernel aegis_package_shared_file:file { write append };
